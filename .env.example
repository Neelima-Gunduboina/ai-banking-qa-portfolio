# ============================================================
# ENVIRONMENT CONFIGURATION — copy to .env, never commit .env
# ============================================================

# Target application
BASE_URL=https://parabank.parasoft.com

# ParaBank test credentials (register a free account on the demo site)
PARABANK_USERNAME=your_username_here
PARABANK_PASSWORD=your_password_here

# LLM API key — required only for GenAI features (self-heal, test-gen, triage)
# Without this key the core Playwright suite still runs normally.
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# LLM model override (optional — defaults to claude-sonnet-4-6)
LLM_MODEL=claude-sonnet-4-6

# GitHub token — used by triage.ts to post PR comments in CI
# Only needed in CI; set as a GitHub Actions secret (GITHUB_TOKEN is auto-provided)
GITHUB_TOKEN=

# CI shard configuration (set automatically by GitHub Actions matrix)
# CI_SHARD_INDEX=1
# CI_SHARD_TOTAL=4
